# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Server only (never exposed to the browser) ---
# Primary AI provider for the advisor (fast, generous free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Backup AI provider + transcript reading (images/PDF):
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default: gemini-2.5-flash, with automatic failover to newer Flash models)
# GEMINI_MODEL=gemini-2.5-flash
# DAILY_REQUEST_BUDGET=500

# Optional: free key from https://api.data.gov/signup (DEMO_KEY is used if empty; fine for light traffic)
# SCORECARD_API_KEY=

# --- Optional: accounts + saved plans (Firebase, free Spark plan) ---
# Firebase web config is public by design; Firestore security rules (firestore.rules) protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
