# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Server only (never exposed to the browser) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model (default: gemini-2.5-flash, with automatic failover to newer Flash models)
# GEMINI_MODEL=gemini-2.5-flash
# DAILY_REQUEST_BUDGET=500

# Optional: free key from https://api.data.gov/signup (DEMO_KEY is used if empty; fine for light traffic)
# SCORECARD_API_KEY=

# --- Optional: accounts + saved plans (Supabase free tier) ---
# The anon key is designed to be public; Row Level Security in supabase/schema.sql protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
